# Conexión a PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL="postgresql://hteoye:hteoye@localhost:5432/hteoye?schema=public"

# Pon "false" para cargar el catálogo sin evaluaciones demostrativas
SEED_DEMO="true"

# Contraseña de las cuentas de DEMOSTRACIÓN del panel (npm run db:seed). Sólo para el prototipo local:
# cámbiala o elimina las cuentas antes de cualquier uso real.
SEED_PASSWORD="Hermosillo-Demo-2026"

# Dirección pública del sitio para los códigos QR del panel (en Vercel se toma sola del dominio de producción)
# SITIO_URL="https://h-teoye.vercel.app"
